{
  "zarr_format": 3,
  "node_type": "group",
  "attributes": {
    "zarr_conventions": [
      {
        "schema_url": "https://raw.githubusercontent.com/Andrew-Keenlyside/zarr-vectors/refs/tags/v0.1.0/schema.json",
        "spec_url": "https://github.com/Andrew-Keenlyside/zarr-vectors/blob/v0.1.0/README.md",
        "uuid": "66268a61-7833-4995-bbcb-233bb417dae5",
        "name": "zarr_vectors",
        "description": "Spatially chunked, multi-resolution N-dimensional vector data (point clouds, meshes, skeletons, streamlines, graphs)"
      },
      {
        "schema_url": "https://raw.githubusercontent.com/zarr-conventions/multiscales/refs/tags/v0.1/schema.json",
        "spec_url": "https://github.com/zarr-conventions/multiscales/blob/v0.1/README.md",
        "uuid": "d35379db-88df-4056-af3a-620245f8e347",
        "name": "multiscales",
        "description": "Multiscale layout of zarr datasets"
      }
    ],
    "zarr_vectors": {
      "kind": "root",
      "zv_version": "0.10.0",
      "axes": [
        {
          "name": "z",
          "type": "space",
          "unit": "micrometer"
        },
        {
          "name": "y",
          "type": "space",
          "unit": "micrometer"
        },
        {
          "name": "x",
          "type": "space",
          "unit": "micrometer"
        }
      ],
      "chunk_shape": [
        200.0,
        200.0,
        200.0
      ],
      "bounds": [
        [
          0,
          0,
          0
        ],
        [
          1000,
          1000,
          1000
        ]
      ],
      "geometry_types": [
        "point_cloud"
      ],
      "links_convention": "implicit_sequential",
      "object_index_convention": "standard",
      "cross_chunk_strategy": "explicit_links",
      "reduction_factor": 8,
      "base_bin_shape": [
        50.0,
        50.0,
        50.0
      ],
      "cross_level_depth": 1,
      "cross_level_storage": "explicit",
      "format_capabilities": [
        "fragment_index",
        "preserved_object_ids",
        "multiscale_links"
      ],
      "attribute_specs": {
        "vertex": {
          "intensity": {
            "dtype": "float32",
            "unit": "arbitrary"
          }
        }
      }
    },
    "multiscales": {
      "layout": [
        {
          "asset": "0"
        },
        {
          "asset": "1",
          "transform": {
            "scale": [
              2.0,
              2.0,
              2.0
            ]
          }
        }
      ]
    }
  }
}
